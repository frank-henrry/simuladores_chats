# Copiar a .env y completar. Este .env representa la config que tendria el
# BACKEND (PHP) del sistema de facturación (no el navegador).

# URL que usa ESTE backend para llamar al Core API.
#
# ATENCION -- esto casi seguro debe ser la URL PUBLICA real:
#   CORE_API_INTERNAL_URL=https://api-chats.virtualfactperu.com/api/v1
#
# El valor "http://core-api:3002/api/v1" (nombre de contenedor Docker) SOLO
# funciona si su servidor corre unido a la red Docker local de quien
# desarrolla virtualfact_chats -- eso NO aplica a un equipo externo. Si
# usan ese valor fuera de esa red, el error es exactamente
# "Could not resolve host: core-api". Usen la URL pública salvo que alguien
# de virtualfact_chats les confirme explícitamente que están en esa misma red.
CORE_API_INTERNAL_URL=https://api-chats.virtualfactperu.com/api/v1

# La llave estática que el equipo de virtualfact_chats le entrega a este
# equipo por un canal seguro (nunca por correo/chat en texto plano). Es
# DISTINTA de la PORTAL_API_KEY del portal cliente -- otro integrador, otra
# llave. Debe coincidir EXACTAMENTE con EMPRESAS_API_KEY del .env de
# virtualfact_chats/servicio-core-api/.env
EMPRESAS_API_KEY=REEMPLAZAR
